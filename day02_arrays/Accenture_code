package day2_arrays;

public class Accenture_code {

    public static int rats(int r, int unit, int[] arr) {
        if (arr.length == 0)
            return 0;

        int foodRequired = r * unit;
        int sum = 0;

        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];

            if (sum >= foodRequired)
                return i + 1;
        }

        return -1;
    }

    public static void main(String[] args) {
        int r = 7;
        int unit = 2;
        int[] arr = {2, 8, 3, 5, 7, 4, 1, 2};

        System.out.println(rats(r, unit, arr));
    }
}
